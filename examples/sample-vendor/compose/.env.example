# Environment Configuration for sample-vendor/demo-app v1.0.0
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the same directory:
#    cp .env.example .env
# 2. Edit .env and replace all placeholder values
# 3. NEVER commit .env to version control (it contains secrets)
# 4. Keep .env.example updated as a reference template
#
# Generated by OVPS on 2026-01-21T03:14:18Z

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application environment (development, staging, production)
APP_ENV=production

# Application debug mode (set to false in production)
APP_DEBUG=false

# Application URL (used for generating links)
APP_URL=http://localhost:8080

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database credentials
# SECURITY: Change these default values before deployment!
DB_HOST=db
DB_PORT=5432
DB_NAME=demo-app
DB_USER=demo-app
DB_PASSWORD=CHANGE_ME_BEFORE_DEPLOYMENT

# =============================================================================
# SECURITY SECRETS
# =============================================================================

# Application secret key (generate with: openssl rand -hex 32)
# SECURITY: Generate a unique value for each deployment!
APP_SECRET_KEY=GENERATE_ME_WITH_openssl_rand_hex_32

# API authentication token (if applicable)
# API_TOKEN=your_api_token_here

# =============================================================================
# EXTERNAL SERVICES (if applicable)
# =============================================================================

# SMTP Configuration (for email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# Container memory limits (optional)
# APP_MEMORY_LIMIT=512m
# DB_MEMORY_LIMIT=1g

# =============================================================================
# LOGGING
# =============================================================================

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================

# Add your application-specific environment variables below
